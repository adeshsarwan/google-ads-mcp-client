# Copy this file to .env for local live Google Ads testing.
# Never commit a real .env file.

GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=

# The manager/MCC customer ID used only as the discovery root.
# Use digits only or hyphenated Google Ads customer ID format.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# Comma-separated customer IDs authorized for reporting functions.
# Discovery does not require this list, but reporting fails closed without it.
GOOGLE_ADS_ALLOWED_CUSTOMER_IDS=

# Optional: pin a packaged Google Ads API version such as v21.
# When omitted, the gateway uses the highest API version packaged by google-ads-python.
GOOGLE_ADS_API_VERSION=

GOOGLE_ADS_RETRY_ATTEMPTS=3
GOOGLE_ADS_RUN_LIVE_TESTS=0

# Optional Streamable HTTP MCP transport settings.
# Defaults bind to localhost for local/personal use.
GOOGLE_ADS_MCP_HOST=127.0.0.1
GOOGLE_ADS_MCP_PORT=8000

# Optional public hostname used by an HTTPS reverse proxy or tunnel.
# This keeps MCP SDK DNS-rebinding protection enabled while allowing that Host header.
GOOGLE_ADS_MCP_PUBLIC_HOST=
GOOGLE_ADS_MCP_PUBLIC_ORIGIN=

# Streamable HTTP MCP authentication.
# oauth is the default for ChatGPT/remote MCP clients.
GOOGLE_ADS_MCP_AUTH_MODE=oauth
GOOGLE_ADS_MCP_OAUTH_DB=/var/lib/google-ads-mcp/oauth.db
GOOGLE_ADS_MCP_OWNER_USERNAME=
GOOGLE_ADS_MCP_OWNER_PASSWORD_HASH=
GOOGLE_ADS_MCP_ACCESS_TOKEN_TTL_SECONDS=3600
GOOGLE_ADS_MCP_AUTH_CODE_TTL_SECONDS=300
GOOGLE_ADS_MCP_REFRESH_TOKEN_TTL_SECONDS=2592000
GOOGLE_ADS_MCP_OAUTH_SECRET=
GOOGLE_ADS_MCP_HTTP_DIAGNOSTICS=0

# Explicit fallback only: set GOOGLE_ADS_MCP_AUTH_MODE=static_bearer
# and use a long random token. OAuth mode ignores this value.
GOOGLE_ADS_MCP_AUTH_TOKEN=
