# Copy this file to .env for local live Google Ads testing.
# Never commit a real .env file.

GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=

# The manager/MCC customer ID used only as the discovery root.
# Use digits only or hyphenated Google Ads customer ID format.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# Comma-separated customer IDs authorized for reporting functions.
# Discovery does not require this list, but reporting fails closed without it.
GOOGLE_ADS_ALLOWED_CUSTOMER_IDS=

# Optional: pin a packaged Google Ads API version such as v21.
# When omitted, the gateway uses the highest API version packaged by google-ads-python.
GOOGLE_ADS_API_VERSION=

GOOGLE_ADS_RETRY_ATTEMPTS=3
GOOGLE_ADS_RUN_LIVE_TESTS=0
